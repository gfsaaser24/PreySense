#pragma classflags("forceupdate")
#pragma namespace("\\\\.\\root\\wmi")
// PreySenseInterfaceVersion=0x0103

[
    Dynamic,
    Provider("WmiProv"),
    WMI,
    Description("PreySense Dedicated Hardware Control Interface"),
    Guid("{09750C8E-7D05-406A-A517-E3EE0DDB63FF}"),
    locale("MS\\0x409")
]
class PreySenseControl
{
    [key, read]
    string InstanceName;

    [read]
    boolean Active;

    [
        WmiMethodId(1),
        Implemented,
        read,
        write,
        Description("Get PreySense ACPI firmware interface version")
    ]
    void GetVersion(
        [out, Description("Interface version in BCD/HEX (0x0103)")] uint32 Version
    );

    [
        WmiMethodId(2),
        Implemented,
        read,
        write,
        Description("Echo Ping test")
    ]
    void Ping(
        [out, Description("Returns ASCII 0x50524559 ('PREY')")] uint32 Magic
    );

    [
        WmiMethodId(3),
        Implemented,
        read,
        write,
        Description("Set CPU PL1, PL2, and encoded RAPL Tau time window")
    ]
    void SetCpuPowerLimits(
        [in, Description("PL1 Sustained Power Limit (mW)")] uint32 Pl1Milliwatts,
        [in, Description("PL2 Burst Power Limit (mW)")] uint32 Pl2Milliwatts,
        [in, Description("Encoded RAPL PL1 time-window byte")] uint32 TauTimeWindow,
        [out, Description("Return code: 0 = Success, 1 = Error/Invalid params")] uint32 ReturnCode
    );

    [
        WmiMethodId(4),
        Implemented,
        read,
        write,
        Description("Get current CPU PL1, PL2, and encoded RAPL Tau from ACPI hardware registers")
    ]
    void GetCpuPowerLimits(
        [out, Description("Current PL1 Sustained Power Limit (mW)")] uint32 Pl1Milliwatts,
        [out, Description("Current PL2 Burst Power Limit (mW)")] uint32 Pl2Milliwatts,
        [out, Description("Current encoded RAPL PL1 time-window byte")] uint32 TauTimeWindow,
        [out, Description("Return code: 0 = Success")] uint32 ReturnCode
    );

    [
        WmiMethodId(5),
        Implemented,
        read,
        write,
        Description("Set GPU target power limit in Watts (85W Base + Delta, 0 Dynamic Boost)")
    ]
    void SetGpuPowerLimit(
        [in, Description("Target GPU Power Limit in Watts (e.g. 130, 140, 150)")] uint32 TargetWatts,
        [out, Description("Return code: 0 = Success, 1 = Error")] uint32 ReturnCode
    );

    [
        WmiMethodId(6),
        Implemented,
        read,
        write,
        Description("Get current GPU target power limit from ACPI NPCF registers")
    ]
    void GetGpuPowerLimit(
        [out, Description("Current GPU target power limit in Watts")] uint32 TargetWatts,
        [out, Description("Return code: 0 = Success")] uint32 ReturnCode
    );

    [
        WmiMethodId(7),
        Implemented,
        read,
        write,
        Description("Set GPU thermal trip point (WMG3) in degrees Celsius (70-87)")
    ]
    void SetGpuThermalTripPoint(
        [in, Description("Target GPU thermal trip point in degrees Celsius (70-87)")] uint32 TempCelsius,
        [out, Description("Return code: 0 = Success, 1 = Error")] uint32 ReturnCode
    );

    [
        WmiMethodId(8),
        Implemented,
        read,
        write,
        Description("Get current GPU thermal trip point (WMG3) in degrees Celsius")
    ]
    void GetGpuThermalTripPoint(
        [out, Description("Current GPU thermal trip point in degrees Celsius")] uint32 TempCelsius,
        [out, Description("Return code: 0 = Success")] uint32 ReturnCode
    );
};
