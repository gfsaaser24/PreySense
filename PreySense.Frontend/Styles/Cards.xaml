<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="PreyCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Border.Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style x:Key="PreySensorCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Border.Padding" Value="12,10" />
  </Style>
  <Style x:Key="PreyBadgeStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ElevatedCardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Border.Padding" Value="10,4" />
  </Style>
</ResourceDictionary>


