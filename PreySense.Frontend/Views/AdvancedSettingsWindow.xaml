<Window x:Class="PreySense.Frontend.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="PreySense • Platform Settings"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Settings Content -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Style="{DynamicResource WindowTitleBarStyle}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/appicon.ico" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PreySense" Style="{DynamicResource WindowTitleTextStyle}"/>
                    <TextBlock Text=" • Settings" Style="{DynamicResource WindowSubtitleTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕" FontSize="{DynamicResource FontSizeTitle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Content Area with consistent margins and spacing -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource WindowContentMargin}">

                    <!-- Section: General Policies -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <!-- Run on Startup Toggle -->
                            <controls:SettingSwitchRow Title="Run on Windows Startup"
                                                      IsChecked="{Binding IsRunOnStartupEnabled, Mode=TwoWay}" 
                                                      Command="{Binding ToggleRunOnStartupCommand}"/>

                            <controls:SettingDropdownRow x:Name="LanguageSelector"
                                                         Title="Language"
                                                         DropdownWidth="190"
                                                         SelectionChanged="LanguageSelector_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US"/>
                                <ComboBoxItem Content="Simplified Chinese" Tag="zh-CN"/>
                            </controls:SettingDropdownRow>

                            <controls:SettingSwitchRow Title="Theme"
                                                      IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                                      OnText="Light"
                                                      OffText="Dark"
                                                      SwitchWidth="92"/>

                            <controls:SettingSwitchRow Title="Battery Health Limit"
                                                      IsChecked="{Binding IsBatteryLimitEnabled, Mode=OneWay}"
                                                      OnText="80%"
                                                      OffText="100%"
                                                      SwitchWidth="92"
                                                      Command="{Binding ToggleBatteryLimitCommand}"/>

                            <controls:SettingSwitchRow Title="Acer Services"
                                                      IsChecked="{Binding IsAcerServicesEnabled, Mode=OneWay}"
                                                      Command="{Binding ToggleAcerServicesDebloaterCommand}"
                                                      OnText="Enabled"
                                                      OffText="Disabled"
                                                      SwitchWidth="120"/>

                            <!-- BlueLight Shield Dropdown -->
                            <controls:SettingDropdownRow Title="Acer BlueLight Shield"
                                                         Margin="0,8,0,8"
                                                         ItemsSource="{Binding BlueLightShieldModes}"
                                                         SelectedIndex="{Binding BlueLightShieldMode, Mode=TwoWay}"
                                                         DropdownWidth="190"/>

                            <!-- LCD Overdrive Toggle -->
                            <controls:SettingSwitchRow Title="LCD Overdrive"
                                                      IsChecked="{Binding IsLcdOverdriveEnabled, Mode=OneWay}" 
                                                      Command="{Binding ToggleLcdOverdriveCommand}"/>

                        </StackPanel>
                    </Border>

                    <!-- Section: USB Power-Off Charging Timeout / Battery Percentage -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="USB Power-Off Charging" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding UsbChargingDisplay}" HorizontalAlignment="Right" Margin="10,0,0,0" FontSize="{DynamicResource FontSizeSectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="{StaticResource StandardRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="30" SmallChange="10" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="10"
                                        Value="{Binding UsbChargingPercent, Mode=TwoWay}"
                                        Style="{StaticResource ReferenceBatterySliderStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,2,0,20"/>

                    <!-- Section: OpenCore ACPI Power Override -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" CornerRadius="4" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-processor-32.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ACPI Override" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AcpiOverrideStatus}" HorizontalAlignment="Right" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeSectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <controls:SettingActionRow Title="Install to USB Drive"
                                                       ActionText="Install"
                                                       Command="{Binding InstallOpenCoreToUsbCommand}"/>

                            <controls:SettingActionRow Title="Install to Boot Drive"
                                                       ActionText="{Binding BootDriveActionText}"
                                                       Command="{Binding ToggleOpenCoreBootDriveCommand}"/>

                            <Separator Margin="0,12"/>

                            <controls:SettingActionRow Title="Factory Profile Calibration"
                                                       ActionText="Calibrate"
                                                       Command="{Binding CalibrateFactoryProfilesCommand}"
                                                       IsEnabled="{Binding IsOpenCoreLoaded}"/>

                            <controls:SettingSwitchRow Title="Enable ACPI Override"
                                                      IsChecked="{Binding IsAcpiOverrideEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEnableAcpiOverride}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>




