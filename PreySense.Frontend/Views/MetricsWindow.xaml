<Window x:Class="PreySense.Frontend.Views.MetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="PreySense • Metrics"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Style="{DynamicResource WindowTitleBarStyle}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/appicon.ico" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PreySense" Style="{DynamicResource WindowTitleTextStyle}"/>
                    <TextBlock Text=" • Metrics" Style="{DynamicResource WindowSubtitleTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕" FontSize="{DynamicResource FontSizeTitle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">

                <!-- Display & Appearance Options -->
                <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Enable Metrics Overlay -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Enable Metrics Overlay" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <controls:RectangularSwitch Grid.Column="1" x:Name="CheckEnableOverlay" Width="56" Height="28" VerticalAlignment="Center" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                        </Grid>

                        <!-- Show in Games Only -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Enabled in Games Only" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <controls:RectangularSwitch Grid.Column="1" x:Name="CheckGameOnly" Width="56" Height="28" VerticalAlignment="Center" Checked="GameOnly_Changed" Unchecked="GameOnly_Changed"/>
                        </Grid>

                        <Separator Margin="0,4,0,8"/>

                        <!-- HUD Scale -->
                        <Grid Margin="{StaticResource StandardRowMargin}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="HUD Scale" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LabelHudScale" Text="100%" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="SliderHudScale" Minimum="50" Maximum="200" Value="100" SmallChange="25" LargeChange="25" TickFrequency="25" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="SliderHudScale_ValueChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Background Opacity -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Background Opacity" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LabelOpacity" Text="50%" HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="SliderOpacity" Minimum="0" Maximum="100" Value="50" SmallChange="10" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="SliderOpacity_ValueChanged"/>
                            </StackPanel>
                        </Grid>

                        <controls:SettingSliderRow x:Name="SliderUpdateInterval"
                                                   Title="Update Interval"
                                                   Minimum="0.25"
                                                   Maximum="3"
                                                   Value="1"
                                                   SmallChange="0.25"
                                                   TickFrequency="0.25"
                                                   IsSnapToTickEnabled="True"
                                                   ValueText="1.00s"
                                                   ValueChanged="SliderUpdateInterval_ValueChanged"/>

                        <Separator Margin="0,4,0,8"/>

                        <!-- Horizontal Position -->
                        <controls:SettingDropdownRow x:Name="DropdownHorizontalPos"
                                                     Title="Horizontal Position"
                                                     SelectionChanged="PositionDropdown_SelectionChanged" />

                        <!-- Vertical Position -->
                        <controls:SettingDropdownRow x:Name="DropdownVerticalPos"
                                                     Title="Vertical Position"
                                                     SelectionChanged="PositionDropdown_SelectionChanged" />

                        <!-- Show FPS Counter -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Show FPS" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <controls:RectangularSwitch Grid.Column="1" x:Name="CheckShowFps" Width="56" Height="28" VerticalAlignment="Center" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </Grid>

                        <!-- Show Frame Time -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Show Frame Time" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <controls:RectangularSwitch Grid.Column="1" x:Name="CheckShowFrameTime" Width="56" Height="28" VerticalAlignment="Center" Checked="FrameTimeSettingChanged" Unchecked="FrameTimeSettingChanged"/>
                        </Grid>
                    </StackPanel>

                </Border>

                <Separator Margin="0,4,0,8"/>

                <Border Style="{StaticResource OriginalSectionPanelStyle}">
                    <StackPanel x:Name="PanelColumnsContainer"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>


