<Window x:Class="PreySense.Frontend.Views.CustomModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PreySense"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PreySense;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PreySense;component/Styles/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PreySense;component/Styles/Spacing.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PreySense;component/Styles/Cards.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PreySense;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{DynamicResource AppWindowShellStyle}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
            TextElement.FontFamily="{DynamicResource AppFontFamily}"
            BorderBrush="{DynamicResource BorderMainBrush}"
            BorderThickness="1"
            CornerRadius="4">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{DynamicResource WindowTitleBarStyle}" Height="32" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/appicon.ico" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PreySense" Style="{DynamicResource WindowTitleTextStyle}"/>
                    <TextBlock x:Name="HeaderSubtitleText" Style="{DynamicResource WindowSubtitleTextStyle}"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{DynamicResource TitleBarCloseButtonStyle}" Content="✕" FontSize="{DynamicResource FontSizeTitle}" Click="CancelButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSecondBrush}" BorderThickness="0,1,0,0">
                <UniformGrid x:Name="ButtonsPanel" Columns="2" Rows="1" Style="{StaticResource WindowFooterPanelStyle}">
                    <Button x:Name="CancelButton" Content="Cancel"
                            Style="{DynamicResource WindowFooterButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{DynamicResource WindowFooterButtonStyle}"
                            FontWeight="SemiBold"
                            Padding="16,0"
                            Click="ConfirmButton_Click"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
