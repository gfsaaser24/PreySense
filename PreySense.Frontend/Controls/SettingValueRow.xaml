<UserControl x:Class="PreySense.Frontend.Controls.SettingValueRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootValueRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title, ElementName=RootValueRow}" Style="{DynamicResource SettingLabelStyle}" />
            <TextBlock Text="{Binding Description, ElementName=RootValueRow}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, ElementName=RootValueRow}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description, ElementName=RootValueRow}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InnerValueBox"
                     Style="{DynamicResource CompactValueTextBoxStyle}"
                     AutomationProperties.AutomationId="{Binding ValueAutomationId, ElementName=RootValueRow}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Unit, ElementName=RootValueRow}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>
    </Grid>
</UserControl>
