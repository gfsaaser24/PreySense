<UserControl x:Class="PreySense.Frontend.Controls.SettingActionRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootActionRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title, ElementName=RootActionRow}" Style="{DynamicResource SettingLabelStyle}" />
            <TextBlock Text="{Binding Description, ElementName=RootActionRow}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, ElementName=RootActionRow}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Button x:Name="InnerButton" Grid.Column="1" VerticalAlignment="Center"
                Style="{DynamicResource OriginalRButtonActionStyle}"
                Height="28" Padding="12,0"
                Content="{Binding ActionText, ElementName=RootActionRow}"
                Command="{Binding Command, ElementName=RootActionRow}"
                CommandParameter="{Binding CommandParameter, ElementName=RootActionRow}"
                Click="InnerButton_Click" />
    </Grid>
</UserControl>
