                0x4E, 0x57, 0xC0, 0xE6, 0x60, 0x03, 0x3C, 0xC4, 0x1E, 0x6C, 0x40, 0x07, 0xCB, 0x0F, 0x36, 0xC0,
                0x33, 0xDC, 0xF1, 0x12, 0x74, 0x57, 0x0F, 0x7E, 0x11, 0xF4, 0x01, 0x04, 0x83, 0xFA, 0xF8, 0x81,
                0xB9, 0xE7, 0xF9, 0xFF, 0x7F, 0xFC, 0x80, 0x2B, 0xEE, 0xDA, 0x21, 0xA4, 0x97, 0x3A, 0x63, 0x45,
                0x7A, 0x9C, 0xB1, 0x2B, 0x08, 0x0D, 0xC7, 0xE8, 0x67, 0xE1, 0x7B, 0x82, 0x8F, 0x0B, 0x46, 0x7A,
                0x18, 0x8B, 0xFF, 0x56, 0xEB, 0x19, 0x1C, 0x54, 0x60, 0x8F, 0x24, 0xC2, 0x73, 0x8D, 0x6F, 0x21,
                0x0E, 0xFF, 0x06, 0xD0, 0xB1, 0x06, 0x17, 0xE9, 0x81, 0xA1, 0x13, 0x10, 0x3B, 0xD6, 0xC0, 0x0E,
                0x00, 0xAA, 0x83, 0x26, 0x97, 0x0E, 0x23, 0xE1, 0x10, 0x3A, 0x74, 0x20, 0xE0, 0x28, 0x88, 0xCF,
                0x06, 0x96, 0x72, 0xAC, 0x01, 0xD5, 0x39, 0x13, 0xB8, 0x9D, 0x06, 0xC0, 0x7E, 0xCE, 0x04, 0x36,
                0x87, 0x3B, 0xB0, 0xFC, 0xFF, 0x0F, 0x77, 0x80, 0x9D, 0x43, 0x0B, 0x70, 0x17, 0x78, 0x68, 0x01,
                0xDD, 0xE5, 0xC9, 0x87, 0x16, 0xE0, 0x1A, 0xE8, 0x70, 0x07, 0xFA, 0xB3, 0x05, 0xFB, 0xFF, 0x9F,
                0x2D, 0xC0, 0x73, 0xAC, 0x83, 0xA3, 0x13, 0x44, 0x30, 0x35, 0x1E, 0xEA, 0x40, 0x71, 0x42, 0xB0,
                0xC0, 0x43, 0x1D, 0xFA, 0x34, 0x70, 0xFE, 0x61, 0x3D, 0x8A, 0x07, 0x7D, 0xE3, 0x1C, 0x1E, 0xBB,
                0xB3, 0xF8, 0x90, 0xC0, 0x0E, 0x08, 0xE4, 0x5C, 0x87, 0x92, 0x00, 0xA3, 0x20, 0xA7, 0x2E, 0x94,
                0xF4, 0x53, 0x17, 0x05, 0x31, 0xA0, 0x75, 0x9D, 0x58, 0x20, 0x5D, 0x07, 0x3C, 0x8B, 0x33, 0x7B,
                0xBA, 0xF1, 0xAC, 0x4E, 0xE3, 0x69, 0xDA, 0xC0, 0x82, 0xD5, 0xB9, 0x0E, 0x6E, 0x9A, 0x73, 0x1D,
                0xC8, 0x8F, 0x0D, 0x9E, 0x26, 0x06, 0xC8, 0xE0, 0xEC, 0x1E, 0xC0, 0xE6, 0xC9, 0xEE, 0x2B, 0xFC,
                0xDC, 0xE1, 0x01, 0x3C, 0x00, 0x78, 0x22, 0xBE, 0x41, 0x7A, 0x6A, 0xB8, 0x1B, 0x91, 0xBD, 0xCD,
                0x5F, 0x17, 0xDD, 0x67, 0xA2, 0x20, 0x4F, 0x76, 0xC0, 0xE9, 0xFF, 0x7F, 0xB2, 0x03, 0xD8, 0x2A,
                0xF1, 0x54, 0x03, 0x3A, 0x0F, 0xA7, 0x1A, 0x10, 0xFC, 0xFF, 0x4F, 0x35, 0xC0, 0x26, 0xD2, 0xC9,
                0x0E, 0xC4, 0x97, 0x0F, 0x70, 0x9C, 0x39, 0x0E, 0xF5, 0x48, 0x43, 0xBF, 0x05, 0xBC, 0x72, 0x3C,
                0x80, 0x80, 0xF7, 0x98, 0xA0, 0x63, 0x0D, 0x3A, 0xE2, 0xA1, 0x0E, 0x7D, 0xAC, 0x01, 0x47, 0x94,
                0x73, 0x1D, 0x2A, 0x04, 0x8C, 0x22, 0x9C, 0xEB, 0x50, 0xA2, 0xE1, 0x28, 0x88, 0x4F, 0x06, 0x16,
                0x75, 0xAC, 0x01, 0x55, 0xFC, 0x23, 0x07, 0x28, 0x62, 0x9C, 0xEB, 0x80, 0xC0, 0x40, 0x71, 0xFF,
                0xFF, 0x7B, 0x0D, 0xB8, 0x0F, 0x77, 0x00, 0x1B, 0xCF, 0x2D, 0xE0, 0x03, 0x37, 0xEC, 0xFF, 0xFF,
                0xB9, 0x05, 0x30, 0x72, 0xB8, 0x03, 0xC3, 0xD9, 0x05, 0x58, 0x11, 0x58, 0xA1, 0x4D, 0x9F, 0x1A,
                0x8D, 0x5A, 0x35, 0x28, 0x53, 0xA3, 0x4C, 0x83, 0x5A, 0x7D, 0x2A, 0x35, 0x66, 0x4C, 0x13, 0x94,
                0x44, 0x1E, 0x51, 0xE8, 0xD1, 0xC5, 0x20, 0x0E, 0xFE, 0x9C, 0x90, 0x91, 0x91, 0xFA, 0x2D, 0x20,
                0x20, 0x47, 0x7A, 0x09, 0x09, 0xC8, 0x01, 0x41, 0x04, 0x64, 0x75, 0x2A, 0x80, 0x98, 0x54, 0x10,
                0x01, 0x59, 0xD8, 0xAA, 0x05, 0x64, 0x95, 0x20, 0x02, 0xB2, 0xB4, 0x75, 0x0B, 0xC8, 0x3A, 0x41,
                0x04, 0xE4, 0x7C, 0x36, 0x80, 0x58, 0x5A, 0x10, 0x01, 0x39, 0xD9, 0x8B, 0x41, 0x40, 0xCE, 0x09,
                0x22, 0x20, 0x27, 0xA4, 0x11, 0x90, 0xF3, 0x52, 0x08, 0xC8, 0x79, 0x95, 0x00, 0xB1, 0xF4, 0x20,
                0x02, 0x72, 0xD6, 0xD7, 0x87, 0x80, 0x9C, 0x1C, 0x44, 0x40, 0x96, 0xE1, 0x05, 0x88, 0x69, 0x02,
                0x11, 0x90, 0xB5, 0xBF, 0x05, 0x04, 0xE4, 0x24, 0x20, 0x02, 0x72, 0x0E, 0x37, 0x40, 0x2C, 0x15,
                0x88, 0x80, 0xFE, 0xFF, 0x09, 0x66, 0x78, 0x63, 0x08, 0xC8, 0x89, 0x40, 0x04, 0xE4, 0x60, 0x7E,
                0x80, 0x58, 0x4A, 0x10, 0x01, 0x59, 0x8D, 0x21, 0x20, 0xA6, 0x0D, 0x44, 0x40, 0xD6, 0xF7, 0x42,
                0x16, 0x90, 0xD5, 0x82, 0x08, 0xC8, 0xDA, 0x2C, 0x01, 0x31, 0xA5, 0x20, 0x02, 0xF2, 0xFF, 0x1F
            })


            /*
             * WM01: PreySense Control Method
             * Arg0: Method Index (uint32)
             * Arg1: Method ID / Command ID (uint32)
             * Arg2: Input buffer
             * Return: Output Package or Integer
             *
             * WmiMethodId 1: GetVersion() -> 0x0100 (v1.0)
             * WmiMethodId 2: Ping() -> 0x50524559 ("PREY")
             * WmiMethodId 3: SetCpuPowerLimits(in pl1_mW, in pl2_mW, in tauEncoded, out retCode)
             * WmiMethodId 4: GetCpuPowerLimits(out pl1_mW, out pl2_mW, out tauEncoded, out retCode)
             * WmiMethodId 5: SetGpuPowerLimit(in targetWatts, out retCode)
             * WmiMethodId 6: GetGpuPowerLimit(out targetWatts, out retCode)
             * WmiMethodId 7: SetGpuThermalTripPoint(in tempCelsius, out retCode)
             * WmiMethodId 8: GetGpuThermalTripPoint(out tempCelsius, out retCode)
             */
            Method (WM01, 3, Serialized)
            {
                Name (PKG1, Package (0x01) { Zero })
                Name (PKG2, Package (0x02) { Zero, Zero })
                Name (PKG3, Package (0x03) { Zero, Zero, Zero })
                Name (PKG4, Package (0x04) { Zero, Zero, Zero, Zero })

                Switch (ToInteger (Arg1))
                {
                    Case (One) // GetVersion
                    {
                        PKG1 [Zero] = 0x0100
                        Return (PKG1)
                    }
                    Case (0x02) // Ping
                    {
                        PKG1 [Zero] = 0x50524559
                        Return (PKG1)
                    }
                    Case (0x03) // SetCpuPowerLimits
                    {
                        Local2 = Zero
                        If (ObjectType (Arg2) == 0x03) // Buffer
                        {
                            If (SizeOf (Arg2) >= 0x08)
                            {
                                CreateDWordField (Arg2, Zero, P1MW)
                                CreateDWordField (Arg2, 0x04, P2MW)
                                Local0 = P1MW
                                Local1 = P2MW
                            }
                            If (SizeOf (Arg2) >= 0x0C)
                            {
                                CreateDWordField (Arg2, 0x08, TAUW)
                                Local2 = TAUW
                            }
                        }
                        Else
                        {
                            Local0 = DerefOf (Arg2 [Zero])
                            Local1 = DerefOf (Arg2 [One])
                            If (SizeOf (Arg2) >= 0x03)
                            {
                                Local2 = DerefOf (Arg2 [0x02])
                            }
                        }

                        If (CondRefOf (\PL1E))
                        {
                            \PL1E = One
                            \PPL1 = (Local0 / 0x7D)
                            \PL2E = One
                            \PPL2 = (Local1 / 0x7D)
                            If (Local2)
                            {
                                \PL1T = (Local2 & 0x7F)
                            }

                            If (CondRefOf (\_TZ.TZ01))
                            {
                                Notify (\_TZ.TZ01, 0x81)
                            }
                            If (CondRefOf (\HIDA))
                            {
                                \HIDA ()
                            }
                            PKG1 [Zero] = Zero
                            Return (PKG1)
                        }
                        PKG1 [Zero] = One
                        Return (PKG1)
                    }
                    Case (0x04) // GetCpuPowerLimits
                    {
                        If (CondRefOf (\PPL1))
                        {
                            Local0 = (\PPL1 * 0x7D)
                            Local1 = (\PPL2 * 0x7D)
                            PKG4 [Zero] = Local0
                            PKG4 [One] = Local1
                            PKG4 [0x02] = (\PL1T & 0x7F)
                            PKG4 [0x03] = Zero
                            Return (PKG4)
                        }
                        PKG4 [Zero] = Zero
                        PKG4 [One] = Zero
                        PKG4 [0x02] = Zero
                        PKG4 [0x03] = One
                        Return (PKG4)
                    }
                    Case (0x05) // SetGpuPowerLimit
                    {
                        If (ObjectType (Arg2) == 0x03)
                        {
                            CreateDWordField (Arg2, Zero, TGW)
                            Local0 = TGW
                        }
                        ElseIf (ObjectType (Arg2) == 0x04)
                        {
                            Local0 = DerefOf (Arg2 [Zero])
                        }
                        Else
                        {
                            Local0 = ToInteger (Arg2)
                        }

                        // Dynamically compute wattage delta above 85W base without hard-clamping upper bound
                        If (Local0 < 85)
                        {
                            Local1 = Zero // Target below base floor runs at base hardware limit
                        }
                        Else
                        {
                            Local1 = (Local0 - 85) // Total delta in Watts above 85W base
                        }

                        // Retain 15W Dynamic Boost headroom for targets above 100W so NVIDIA driver unlocks upper tier
                        If (Local1 > 15)
                        {
                            Local2 = (Local1 - 15) // Configurable TGP delta in Watts (ctgpOffsetmW)
                            Local3 = 15            // Dynamic Boost delta in Watts (maxOutputOffsetmW)
                        }
                        Else
                        {
                            Local2 = Local1        // Direct TGP delta in Watts
                            Local3 = Zero          // Zero Dynamic Boost
                        }

                        Local4 = Local1            // Platform Cap delta in Watts (targetTppOffsetmW) - unconstrained headroom

                        // Update active NPCF registers in 125mW units (watts * 8)
                        If (CondRefOf (\_SB.NPCF.ACBT))
                        {
                            \_SB.NPCF.ACBT = (Local2 * 0x08)
                            \_SB.NPCF.AMAT = (Local3 * 0x08)
                            \_SB.NPCF.ATPP = (Local4 * 0x08)
                        }

                        // Update ERM4 thermal mode table
                        If (CondRefOf (\_SB.CAUM))
                        {
                            Switch (ToInteger (\_SB.CAUM))
                            {
                                Case (Zero) // Turbo (M4)
                                {
                                    If (CondRefOf (\_SB.M4CT)) { \_SB.M4CT = Local2 }
                                    If (CondRefOf (\_SB.M4DB)) { \_SB.M4DB = Local3 }
                                    If (CondRefOf (\_SB.M4CP)) { \_SB.M4CP = Local4 }
                                }
                                Case (One) // Performance (M3)
                                {
                                    If (CondRefOf (\_SB.M3CT)) { \_SB.M3CT = Local2 }
                                    If (CondRefOf (\_SB.M3DB)) { \_SB.M3DB = Local3 }
                                    If (CondRefOf (\_SB.M3CP)) { \_SB.M3CP = Local4 }
                                }
                                Case (0x02) // Balanced (M2)
                                {
                                    If (CondRefOf (\_SB.M2CT)) { \_SB.M2CT = Local2 }
                                    If (CondRefOf (\_SB.M2DB)) { \_SB.M2DB = Local3 }
                                    If (CondRefOf (\_SB.M2CP)) { \_SB.M2CP = Local4 }
                                }
                                Case (0x03) // Quiet (M1)
                                {
                                    If (CondRefOf (\_SB.M1CT)) { \_SB.M1CT = Local2 }
                                    If (CondRefOf (\_SB.M1DB)) { \_SB.M1DB = Local3 }
                                    If (CondRefOf (\_SB.M1CP)) { \_SB.M1CP = Local4 }
                                }
                            }
                        }
                        Else
                        {
                            If (CondRefOf (\_SB.M4CT)) { \_SB.M4CT = Local2 }
                            If (CondRefOf (\_SB.M4DB)) { \_SB.M4DB = Local3 }
                            If (CondRefOf (\_SB.M4CP)) { \_SB.M4CP = Local4 }
                        }

                        // Notify NVIDIA driver of power limit change
                        If (CondRefOf (\_SB.NPCF))
                        {
                            Notify (\_SB.NPCF, 0xC0)
                            Notify (\_SB.NPCF, 0xC1)
                        }

                        PKG1 [Zero] = Zero
                        Return (PKG1)
                    }
                    Case (0x06) // GetGpuPowerLimit
                    {
                        If (CondRefOf (\_SB.NPCF.ACBT))
                        {
                            Local0 = 85
                            Local0 += (\_SB.NPCF.ACBT / 0x08)
                            If (CondRefOf (\_SB.NPCF.AMAT))
                            {
                                Local0 += (\_SB.NPCF.AMAT / 0x08)
                            }
                            PKG2 [Zero] = Local0
                            PKG2 [One] = Zero
                            Return (PKG2)
                        }
                        PKG2 [Zero] = 85
                        PKG2 [One] = One
                        Return (PKG2)
                    }
                    Case (0x07) // SetGpuThermalTripPoint
                    {
                        If (ObjectType (Arg2) == 0x03)
                        {
                            CreateDWordField (Arg2, Zero, TGT)
                            Local0 = TGT
                        }
                        ElseIf (ObjectType (Arg2) == 0x04)
                        {
                            Local0 = DerefOf (Arg2 [Zero])
                        }
                        Else
                        {
                            Local0 = ToInteger (Arg2)
                        }

                        // Safe bounds: 70°C to 89°C (NVML GPU_MAX operating thermal limit)
                        If (Local0 < 70) { Local0 = 70 }
                        If (Local0 > 89) { Local0 = 89 }

                        If (CondRefOf (\_SB.NPCF.WMG3))
                        {
                            \_SB.NPCF.WMG3 = Local0
                            If (CondRefOf (\_SB.NPCF))
                            {
                                Notify (\_SB.NPCF, 0xC0)
                                Notify (\_SB.NPCF, 0xC1)
                            }
                            PKG1 [Zero] = Zero
                            Return (PKG1)
                        }
                        PKG1 [Zero] = One
                        Return (PKG1)
                    }
                    Case (0x08) // GetGpuThermalTripPoint
                    {
                        If (CondRefOf (\_SB.NPCF.WMG3))
                        {
                            PKG2 [Zero] = \_SB.NPCF.WMG3
                            PKG2 [One] = Zero
                            Return (PKG2)
                        }
                        PKG2 [Zero] = 79 // Factory default 79°C
                        PKG2 [One] = One
                        Return (PKG2)
                    }
                    Default
                    {
                        PKG1 [Zero] = One
                        Return (PKG1)
                    }
                }
            }
        }
    }
}
